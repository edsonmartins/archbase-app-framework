<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>archbase-app-framework</artifactId>
        <groupId>br.com.archbase</groupId>
        <version>3.1.14</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>archbase-starter-core</artifactId>
    <name>Archbase Starter Core</name>

    <dependencies>
        <dependency>
            <groupId>br.com.archbase</groupId>
            <version>3.1.14</version>
            <artifactId>archbase-domain-driven-design</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-persistence</artifactId>
        </dependency>
        <!-- O spring-data-rest-webmvc saiu daqui: era exigido apenas pela interface
             RepositoryRestConfigurer que ArchbaseServerMvcConfiguration declarava sem usar. Ele
             arrastava o spring-hateoas e, com os dois no classpath, o springdoc ativava
             configurações que no Boot 4 pedem autoconfigurações separadas — derrubando a subida de
             quem nunca pediu Spring Data REST.

             Aplicações que realmente usem Spring Data REST ou HATEOAS devem declarar
             spring-boot-starter-data-rest / spring-boot-starter-hateoas, que trazem a biblioteca e
             a autoconfiguração correspondente. -->

        <dependency>
            <groupId>br.com.archbase</groupId>
            <artifactId>archbase-multitenancy</artifactId>
            <version>3.1.14</version>
        </dependency>
        <dependency>
            <groupId>br.com.archbase</groupId>
            <version>3.1.14</version>
            <artifactId>archbase-resource-logger</artifactId>
        </dependency>
        <dependency>
            <groupId>br.com.archbase</groupId>
            <artifactId>archbase-domain-driven-design-spec</artifactId>
            <version>3.1.14</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>br.com.archbase</groupId>
            <artifactId>archbase-validation</artifactId>
            <version>3.1.14</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.modelmapper</groupId>
            <artifactId>modelmapper</artifactId>
            <version>${modelmapper.version}</version>
        </dependency>
        <dependency>
            <groupId>tools.jackson.datatype</groupId>
            <artifactId>jackson-datatype-hibernate7</artifactId>
            <version>3.1.4</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
